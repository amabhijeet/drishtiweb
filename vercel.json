{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node build-vercel.cjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [{"source": "/login", "destination": "/", "permanent": false}],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    }
  ]
}
